# Release signing for scripts/build-release.sh / ./gradlew assembleRelease
# Copy to keystore.properties (gitignored) and fill in real values. Never commit keystore.properties.

# Path relative to seniorhigh-android/ (default keystore lives in seniorhigh-script, outside this repo)
storeFile=../seniorhigh-script/keystore/mykey.jks
storePassword=your_keystore_password_here
keyAlias=your_key_alias_here
keyPassword=your_key_password_here
