<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="4dp"
    android:paddingBottom="20dp">

    <LinearLayout
        style="@style/SectionCard"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/dialog_first_year"
            style="@style/YearChip"/>

        <TextView
            android:id="@+id/dialog_first_weight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:textSize="14sp"
            android:textColor="@color/ink_secondary"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    style="@style/StatLabel"
                    android:text="平均"/>
                <TextView
                    android:id="@+id/dialog_first_balance"
                    style="@style/StatValue"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    style="@style/StatLabel"
                    android:text="總分"/>
                <TextView
                    android:id="@+id/dialog_first_all_grade"
                    style="@style/StatValue"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    style="@style/StatLabel"
                    android:text="人數"/>
                <TextView
                    android:id="@+id/dialog_first_people"
                    style="@style/StatValue"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dialog_second_section"
        style="@style/SectionCard"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/dialog_second_year"
            style="@style/YearChip"/>

        <TextView
            android:id="@+id/dialog_second_weight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="2dp"
            android:textSize="14sp"
            android:textColor="@color/ink_secondary"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                android:id="@+id/dialog_second_balance_prompt"
                    style="@style/StatLabel"
                    android:text="平均"/>
                <TextView
                    android:id="@+id/dialog_second_balance"
                    style="@style/StatValue"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                android:id="@+id/dialog_second_all_grade_prompt"
                    style="@style/StatLabel"
                    android:text="總分"/>
                <TextView
                    android:id="@+id/dialog_second_all_grade"
                    style="@style/StatValue"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                android:id="@+id/dialog_second_people_prompt"
                    style="@style/StatLabel"
                    android:text="人數"/>
                <TextView
                    android:id="@+id/dialog_second_people"
                    style="@style/StatValue"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical|end"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="加入收藏"
            android:textColor="@color/ink_secondary"
            android:textSize="13sp"/>
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/favorite_button"
            style="@style/FavoriteButton"
            android:background="@drawable/ic_favorite_border"/>
    </LinearLayout>

</LinearLayout>
