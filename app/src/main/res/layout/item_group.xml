<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/cardMarginH"
    android:paddingEnd="@dimen/cardMarginH"
    android:paddingTop="@dimen/cardMarginV"
    android:paddingBottom="@dimen/cardMarginV"
    android:clickable="true"
    android:focusable="true">
<com.google.android.material.card.MaterialCardView
    style="@style/ListCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="0dp"
    android:duplicateParentState="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/item_title_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_school_small"
                android:drawablePadding="6dp"
                android:drawableTint="@color/ink_tertiary"
                android:gravity="center_vertical"
                android:textSize="13sp"
                android:textColor="@color/ink_secondary"/>
            <TextView
                android:id="@+id/item_subtitle_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:lineSpacingExtra="2dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/ink" />
        </LinearLayout>

        <com.feveral.seniorhigh.ui.ScoreChipView
            android:id="@+id/item_title_remark"
            style="@style/ScoreChip.List"
            android:layout_marginStart="12dp"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
</FrameLayout>
