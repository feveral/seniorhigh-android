<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fadeScrollbars="true"
    android:scrollbarStyle="outsideOverlay">
<LinearLayout
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="4dp"
    android:paddingBottom="20dp">

    <LinearLayout
        style="@style/SectionCard"
        android:layout_marginTop="12dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <TextView
                android:id="@+id/basic_dialog_first_year_year_title"
                style="@style/YearChip"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:id="@+id/basic_dialog_first_year_quota_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="招生名額"
                    android:textColor="@color/ink_secondary"
                    android:textSize="12sp"/>
                <TextView
                    android:id="@+id/basic_dialog_first_year_quota"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/ink"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="篩選順序 · 最低級分"
            android:textColor="@color/ink_tertiary"
            android:textSize="12sp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="46dp"
            android:paddingTop="8dp"
            android:tag="score_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <TextView
                android:id="@+id/basic_dialog_first_year_first_title"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_icon_circle"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/on_indigo_container"
                android:textSize="12sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/basic_dialog_first_year_first_subject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:textColor="@color/ink"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/basic_dialog_first_year_first_grade"
                style="@style/ScoreChip.Dialog"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="46dp"
            android:paddingTop="8dp"
            android:tag="score_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <TextView
                android:id="@+id/basic_dialog_first_year_second_title"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_icon_circle"
                android:gravity="center"
                android:text="2"
                android:textColor="@color/on_indigo_container"
                android:textSize="12sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/basic_dialog_first_year_second_subject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:textColor="@color/ink"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/basic_dialog_first_year_second_grade"
                style="@style/ScoreChip.Dialog"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="46dp"
            android:paddingTop="8dp"
            android:tag="score_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <TextView
                android:id="@+id/basic_dialog_first_year_third_title"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_icon_circle"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/on_indigo_container"
                android:textSize="12sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/basic_dialog_first_year_third_subject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:textColor="@color/ink"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/basic_dialog_first_year_third_grade"
                style="@style/ScoreChip.Dialog"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="46dp"
            android:paddingTop="8dp"
            android:tag="score_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <TextView
                android:id="@+id/basic_dialog_first_year_forth_title"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_icon_circle"
                android:gravity="center"
                android:text="4"
                android:textColor="@color/on_indigo_container"
                android:textSize="12sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/basic_dialog_first_year_forth_subject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:textColor="@color/ink"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/basic_dialog_first_year_forth_grade"
                style="@style/ScoreChip.Dialog"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="46dp"
            android:paddingTop="8dp"
            android:tag="score_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <TextView
                android:id="@+id/basic_dialog_first_year_fifth_title"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_icon_circle"
                android:gravity="center"
                android:text="5"
                android:textColor="@color/on_indigo_container"
                android:textSize="12sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/basic_dialog_first_year_fifth_subject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:textColor="@color/ink"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/basic_dialog_first_year_fifth_grade"
                style="@style/ScoreChip.Dialog"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/basic_dialog_second_section"
        style="@style/SectionCard"
        android:layout_marginTop="12dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <TextView
                android:id="@+id/basic_dialog_second_year_year_title"
                style="@style/YearChip"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:id="@+id/basic_dialog_second_year_quota_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="招生名額"
                    android:textColor="@color/ink_secondary"
                    android:textSize="12sp"/>
                <TextView
                    android:id="@+id/basic_dialog_second_year_quota"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@color/ink"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="篩選順序 · 最低級分"
            android:textColor="@color/ink_tertiary"
            android:textSize="12sp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="46dp"
            android:paddingTop="8dp"
            android:tag="score_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <TextView
                android:id="@+id/basic_dialog_second_year_first_title"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_icon_circle"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/on_indigo_container"
                android:textSize="12sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/basic_dialog_second_year_first_subject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:textColor="@color/ink"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/basic_dialog_second_year_first_grade"
                style="@style/ScoreChip.Dialog"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="46dp"
            android:paddingTop="8dp"
            android:tag="score_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <TextView
                android:id="@+id/basic_dialog_second_year_second_title"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_icon_circle"
                android:gravity="center"
                android:text="2"
                android:textColor="@color/on_indigo_container"
                android:textSize="12sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/basic_dialog_second_year_second_subject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:textColor="@color/ink"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/basic_dialog_second_year_second_grade"
                style="@style/ScoreChip.Dialog"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="46dp"
            android:paddingTop="8dp"
            android:tag="score_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <TextView
                android:id="@+id/basic_dialog_second_year_third_title"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_icon_circle"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/on_indigo_container"
                android:textSize="12sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/basic_dialog_second_year_third_subject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:textColor="@color/ink"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/basic_dialog_second_year_third_grade"
                style="@style/ScoreChip.Dialog"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="46dp"
            android:paddingTop="8dp"
            android:tag="score_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <TextView
                android:id="@+id/basic_dialog_second_year_forth_title"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_icon_circle"
                android:gravity="center"
                android:text="4"
                android:textColor="@color/on_indigo_container"
                android:textSize="12sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/basic_dialog_second_year_forth_subject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:textColor="@color/ink"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/basic_dialog_second_year_forth_grade"
                style="@style/ScoreChip.Dialog"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="46dp"
            android:paddingTop="8dp"
            android:tag="score_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <TextView
                android:id="@+id/basic_dialog_second_year_fifth_title"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_icon_circle"
                android:gravity="center"
                android:text="5"
                android:textColor="@color/on_indigo_container"
                android:textSize="12sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/basic_dialog_second_year_fifth_subject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:textColor="@color/ink"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/basic_dialog_second_year_fifth_grade"
                style="@style/ScoreChip.Dialog"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
            android:baselineAligned="false">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="加入收藏"
            android:textColor="@color/ink_secondary"
            android:textSize="13sp"/>
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/favorite_button"
            style="@style/FavoriteButton"
            android:background="@drawable/ic_favorite_border"/>
    </LinearLayout>

</LinearLayout>
</androidx.core.widget.NestedScrollView>
