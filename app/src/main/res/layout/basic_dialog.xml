<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="4dp"
    android:paddingBottom="20dp">

    <LinearLayout
        style="@style/SectionCard"
        android:layout_marginTop="12dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/basic_dialog_first_year_year_title"
                style="@style/YearChip"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="篩選順序"
                android:textColor="@color/ink_tertiary"
                android:textSize="12sp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/basic_dialog_first_year_first_title"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_icon_circle"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/on_indigo_container"
                android:textSize="12sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/basic_dialog_first_year_first_subject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="10dp"
                android:layout_marginStart="12dp"
                android:textColor="@color/ink"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/basic_dialog_first_year_first_grade"
                style="@style/ScoreChip"
                android:layout_marginTop="10dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/basic_dialog_first_year_second_title"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_icon_circle"
                android:gravity="center"
                android:text="2"
                android:textColor="@color/on_indigo_container"
                android:textSize="12sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/basic_dialog_first_year_second_subject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="10dp"
                android:layout_marginStart="12dp"
                android:textColor="@color/ink"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/basic_dialog_first_year_second_grade"
                style="@style/ScoreChip"
                android:layout_marginTop="10dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/basic_dialog_first_year_third_title"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_icon_circle"
                android:gravity="center"
                android:text="3"
                android:textColor="@color/on_indigo_container"
                android:textSize="12sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/basic_dialog_first_year_third_subject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginTop="10dp"
                android:layout_marginStart="12dp"
                android:textColor="@color/ink"
                android:textSize="16sp"/>
            <TextView
                android:id="@+id/basic_dialog_first_year_third_grade"
                style="@style/ScoreChip"
                android:layout_marginTop="10dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/basic_dialog_first_year_forth_title"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_icon_circle"
                android:gravity="center"
                android:text="4"
                android:textColor="@color/on_indigo_container"
                android:textSize="12sp"
                android:textStyle="bold"/>
